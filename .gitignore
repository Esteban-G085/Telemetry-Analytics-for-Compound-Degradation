# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Datos generados (artefactos grandes, se regeneran con `python -m telemetria pipeline`)
data/raw/*.csv
data/processed/*.csv
data/processed/*.csv.gz
data/processed/*.joblib
data/reports/*.html
data/reports/**/*.html
data/vivo/*.csv

# Frontend (Node)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Mantener la estructura de carpetas
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/reports/.gitkeep
!data/vivo/.gitkeep
